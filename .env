COMPOSE_PROJECT_NAME=koin

APP_VERSION=1.0.0

# Переменные для БД
POSTGRES_USER=koin
POSTGRES_PASSWORD=123
POSTGRES_DB=koin
POSTGRES_SCHEMA=koin
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=./data/pgsql
POSTGRES_EXT_PORT=5430

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
